// Initial persistence configuration. Domain models will be introduced in later work.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}
// The SQLite connector stores this as text; application contracts enforce the role set.
model User {
  id           String        @id @default(cuid())
  fullName     String
  email        String        @unique
  phone        String?       @unique
  passwordHash String
  role         String        @default("DONOR")
  donorType    String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  sessions     AuthSession[]
  donations    Donation[]
  recipientProfile RecipientProfile?
}

model AuthSession {
  tokenHash String   @id
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Donation {
  id             String   @id @default(cuid())
  donorId        String
  foodName       String
  category       String
  quantity       Float
  unit           String
  preparedAt     DateTime?
  expiresAt      DateTime
  pickupAddress  String
  pickupArea     String
  latitude       Float?
  longitude      Float?
  description    String?
  status         String   @default("AVAILABLE")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  donor          User     @relation(fields: [donorId], references: [id], onDelete: Restrict)

  @@index([donorId, status, createdAt])
  @@index([status, category, expiresAt])
  @@index([expiresAt])
}

model RecipientProfile {
  id                     String   @id @default(cuid())
  userId                 String   @unique
  organizationName       String
  recipientType          String
  description             String?
  address                 String
  serviceArea             String
  latitude                Float?
  longitude               Float?
  serviceRadiusKm         Float?
  capacityQuantity        Float?
  capacityUnit            String?
  dietaryRestrictions     String?
  availabilityNotes       String?
  isAcceptingDonations    Boolean  @default(true)
  isActive                Boolean  @default(true)
  verificationStatus      String   @default("PENDING")
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
  user                    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  acceptedCategories      RecipientFoodCategory[]

  @@index([verificationStatus, isActive, isAcceptingDonations])
  @@index([recipientType, serviceArea])
}

model RecipientFoodCategory {
  id          String           @id @default(cuid())
  profileId   String
  category    String
  profile     RecipientProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, category])
  @@index([category])
}
