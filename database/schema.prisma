// Initial persistence configuration. Domain models will be introduced in later work.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}
// The SQLite connector stores this as text; application contracts enforce the role set.
model User {
  id           String        @id @default(cuid())
  fullName     String
  email        String        @unique
  phone        String?       @unique
  passwordHash String
  role         String        @default("DONOR")
  donorType    String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  sessions     AuthSession[]
  donations    Donation[]
}

model AuthSession {
  tokenHash String   @id
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Donation {
  id             String   @id @default(cuid())
  donorId        String
  foodName       String
  category       String
  quantity       Float
  unit           String
  preparedAt     DateTime?
  expiresAt      DateTime
  pickupAddress  String
  pickupArea     String
  latitude       Float?
  longitude      Float?
  description    String?
  status         String   @default("AVAILABLE")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  donor          User     @relation(fields: [donorId], references: [id], onDelete: Restrict)

  @@index([donorId, status, createdAt])
  @@index([status, category, expiresAt])
  @@index([expiresAt])
}
