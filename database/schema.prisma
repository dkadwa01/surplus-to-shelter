// Initial persistence configuration. Domain models will be introduced in later work.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}
// The SQLite connector stores this as text; application contracts enforce the role set.
model User {
  id           String        @id @default(cuid())
  fullName     String
  email        String        @unique
  phone        String?       @unique
  passwordHash String
  role         String        @default("DONOR")
  donorType    String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  sessions     AuthSession[]
  donations    Donation[]
  recipientProfile RecipientProfile?
  verificationRequests VerificationRequest[]
  verificationReviews VerificationRecord[] @relation("VerificationReviewer")
  organizedCommunityDonations CommunityDonation[] @relation("CommunityOrganizer")
  communityContributions CommunityContribution[] @relation("CommunityContributor")
  driverProfile DriverProfile?
  dispatchesCreated DispatchAssignment[] @relation("DispatchCreator")
  dispatchesDriven DispatchAssignment[] @relation("DispatchDriver")
}

model AuthSession {
  tokenHash String   @id
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Donation {
  id             String   @id @default(cuid())
  donorId        String
  foodName       String
  category       String
  quantity       Float
  unit           String
  preparedAt     DateTime?
  expiresAt      DateTime
  pickupAddress  String
  pickupArea     String
  latitude       Float?
  longitude      Float?
  description    String?
  status         String   @default("AVAILABLE")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  donor          User     @relation(fields: [donorId], references: [id], onDelete: Restrict)
  dispatchAssignment DispatchAssignment?

  @@index([donorId, status, createdAt])
  @@index([status, category, expiresAt])
  @@index([expiresAt])
}

model RecipientProfile {
  id                     String   @id @default(cuid())
  userId                 String   @unique
  organizationName       String
  recipientType          String
  description             String?
  address                 String
  serviceArea             String
  latitude                Float?
  longitude               Float?
  serviceRadiusKm         Float?
  capacityQuantity        Float?
  capacityUnit            String?
  dietaryRestrictions     String?
  availabilityNotes       String?
  isAcceptingDonations    Boolean  @default(true)
  isActive                Boolean  @default(true)
  verificationStatus      String   @default("PENDING")
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
  user                    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  acceptedCategories      RecipientFoodCategory[]
  dispatchAssignments DispatchAssignment[]

  @@index([verificationStatus, isActive, isAcceptingDonations])
  @@index([recipientType, serviceArea])
}

model RecipientFoodCategory {
  id          String           @id @default(cuid())
  profileId   String
  category    String
  profile     RecipientProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, category])
  @@index([category])
}

model VerificationRequest {
  id                String   @id @default(cuid())
  userId            String
  participantType   String
  status            String   @default("PENDING")
  activeUserId      String?  @unique
  organizationName  String?
  vehicleType       String?
  additionalInfo    String?
  reviewReason      String?
  reviewedAt        DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  records           VerificationRecord[]

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model VerificationRecord {
  id              String              @id @default(cuid())
  requestId       String
  previousStatus  String?
  newStatus       String
  reviewerId      String?
  reason          String?
  createdAt       DateTime            @default(now())
  request         VerificationRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  reviewer        User?               @relation("VerificationReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)

  @@index([requestId, createdAt])
  @@index([reviewerId])
}

model CommunityDonation {
  id             String   @id @default(cuid())
  creatorId      String
  title          String
  description    String?
  pickupArea     String
  latitude       Float?
  longitude      Float?
  targetQuantity Float?
  targetCategory String?
  targetUnit     String?
  deadline       DateTime
  status         String   @default("OPEN")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  creator        User     @relation("CommunityOrganizer", fields: [creatorId], references: [id], onDelete: Restrict)
  contributions  CommunityContribution[]
  dispatchAssignments DispatchAssignment[]

  @@index([status, pickupArea, deadline])
  @@index([creatorId, status, createdAt])
  @@index([deadline, status])
}

model CommunityContribution {
  id                       String   @id @default(cuid())
  communityDonationId      String
  contributorId            String
  foodName                 String
  category                 String
  quantity                 Float
  unit                     String
  expiresAt                DateTime
  note                     String?
  status                   String   @default("ACTIVE")
  belowIndividualThreshold Boolean  @default(false)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
  communityDonation        CommunityDonation @relation(fields: [communityDonationId], references: [id], onDelete: Restrict)
  contributor              User     @relation("CommunityContributor", fields: [contributorId], references: [id], onDelete: Restrict)
  dispatchAssignment DispatchAssignment?

  @@index([communityDonationId, status, createdAt])
  @@index([contributorId, status, createdAt])
  @@index([category, unit, status])
}

model DriverProfile {
  id              String   @id @default(cuid())
  userId          String   @unique
  vehicleType     String
  capacityQuantity Float
  capacityUnit    String
  serviceArea     String
  serviceRadiusKm Float?
  latitude        Float?
  longitude       Float?
  availability    String   @default("OFFLINE")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([availability, serviceArea])
}

model DispatchAssignment {
  id                    String   @id @default(cuid())
  donationId            String?  @unique
  communityContributionId String? @unique
  communityDonationId   String?
  recipientProfileId    String
  createdById           String
  assignedDriverId      String?
  status                String   @default("AVAILABLE")
  pickupStartedAt       DateTime?
  pickedUpAt            DateTime?
  transitStartedAt      DateTime?
  deliveredAt           DateTime?
  completedAt           DateTime?
  cancelledAt           DateTime?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  donation              Donation? @relation(fields: [donationId], references: [id], onDelete: Restrict)
  communityContribution CommunityContribution? @relation(fields: [communityContributionId], references: [id], onDelete: Restrict)
  communityDonation     CommunityDonation? @relation(fields: [communityDonationId], references: [id], onDelete: Restrict)
  recipientProfile      RecipientProfile @relation(fields: [recipientProfileId], references: [id], onDelete: Restrict)
  createdBy             User @relation("DispatchCreator", fields: [createdById], references: [id], onDelete: Restrict)
  assignedDriver        User? @relation("DispatchDriver", fields: [assignedDriverId], references: [id], onDelete: Restrict)

  @@index([status, createdAt])
  @@index([assignedDriverId, status])
  @@index([recipientProfileId, status])
}

// Admin-managed individual-post thresholds. Collective contributions remain
// allowed below these values and are explicitly marked as community exceptions.
model IndividualContributionThreshold {
  id              String   @id @default(cuid())
  category        String
  unit            String
  minimumQuantity Float
  updatedAt       DateTime @updatedAt

  @@unique([category, unit])
}
