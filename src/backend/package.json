{
    "name":  "@surplus/backend",
    "private":  true,
    "version":  "0.1.0",
    "type":  "module",
    "scripts":  {
                    "dev":  "npm run build \u0026\u0026 concurrently -k \"tsc -p tsconfig.json --watch --preserveWatchOutput\" \"node --watch dist/server.js\"",
                    "build":  "tsc -p tsconfig.json",
                    "typecheck":  "tsc --noEmit -p tsconfig.json",
                    "start":  "node dist/server.js"
                },
    "dependencies":  {
                         "@prisma/client":  "^6.19.0",
                         "@surplus/shared":  "*",
                         "cors":  "^2.8.5",
                         "dotenv":  "^16.6.1",
                         "express":  "^4.21.2",
                         "zod":  "^3.25.76"
                     },
    "devDependencies":  {
                            "@types/cors":  "^2.8.19",
                            "@types/express":  "^5.0.3",
                            "@types/node":  "^22.18.6",
                            "typescript":  "^5.9.3"
                        }
}